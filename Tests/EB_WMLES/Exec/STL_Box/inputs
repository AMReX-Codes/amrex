
# ── STL_Box: 3D flow over an STL-imported box ──
#
# This test demonstrates the STL → EB pipeline for EB_WMLES.
# The box STL is auto-generated by running:  python make_stl.py
#
# To use your own CAD model, replace eb2.stl_file and adjust
# eb2.stl_scale + eb2.stl_center accordingly.

max_step = 400
stop_time = 5.0

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = -3.0   -1.5   -1.5
geometry.prob_hi     =  8.0    1.5    1.5
amr.n_cell           = 128     36     36

# BC: 0=Interior, 1=Inflow, 2=Outflow, 3=Symmetry, 4=SlipWall, 5=NoSlipWall
wmles.lo_bc = 1 4 4
wmles.hi_bc = 2 4 4

wmles.cfl = 0.5

wmles.v = 1
amr.v = 1

# Physical parameters
wmles.mu = 1.0e-4          # dynamic viscosity
wmles.Pr  = 0.72

# LOAD BALANCE
amr.loadbalance_with_workestimates = 1
amr.loadbalance_level0_int = 1000

# REFINEMENT
amr.max_level       = 0
amr.ref_ratio       = 2
amr.regrid_int      = 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2

# CHECKPOINT
amr.checkpoint_files_output = 0
amr.check_file      = chk
amr.check_int       = 500

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 100
amr.derive_plot_vars  = pressure x_velocity y_velocity z_velocity

# ── EB: STL geometry ──
eb2.geom_type = stl
eb2.stl_file = "box.stl"
eb2.stl_scale = 1.0
eb2.stl_center = 0.0  0.0  0.0
eb2.stl_reverse_normal = 0
eb2.stl_use_bvh = 1

# ── Problem parameters ──
prob.inflow_velocity = 1.0
prob.inflow_rho      = 1.0
prob.inflow_T        = 300.0
prob.inflow_p        = 71500.0
