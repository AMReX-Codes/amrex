# HypreMLABecLap's composite EB solve (IJ mode) compared with MLMG's: flower
# geometry, EB Dirichlet, two levels with the fine level over the whole
# domain, so that the two composite operators are the same (the solutions
# agree to ~1e-12 on CPUs and ~2e-10 on GPUs; also with max_level = 0)
composite_solve = 1
use_mlhypre = 1
mlhypre_max_diff = 1.e-9
linop_maxorder = 3 # HypreMLABecLap is hardwired to maxorder 3
reltol = 1.e-11
prob_type = 2
max_level = 1
n_cell = 64
max_grid_size = 32
eb2.max_grid_size = 32
eb2.geom_type = flower
hypre_mlabeclap.hypre_solver = FlexGMRES
hypre_mlabeclap.hypre_preconditioner = BoomerAMG
verbose = 1
bottom_verbose = 0
