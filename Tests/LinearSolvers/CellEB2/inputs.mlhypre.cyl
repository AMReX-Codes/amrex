# HypreMLABecLap's composite EB solve (IJ mode) compared with MLMG's, 2D or
# 3D: a cylinder (sphere in 3D) of fluid outside, crossing the boundary of
# the fine level.  At cut cells on the coarse/fine boundary the composite
# operators differ by design (HypreMLABecLap's fluxes there are the
# area-weighted fine fluxes, MLMG's reflux is not volume or area weighted),
# so the solutions differ by O(1e-4) and only the finest level's MLMG
# residual (volume-weighted, as HypreMLABecLap's system) is checked.
# Variants (command-line arguments):
#   eb_neumann = 1                   homogeneous Neumann on the EB
#   hypre_mlabeclap.backend = algmg  AlgMG instead of hypre
#   mlhypre_num_setups = 3           setups with reuse, scaled coefficients
#   acoef = 1                        a != 0
#   max_level = 2 fine_shrink = 0.03125   three levels
#   ref_ratio = 4 n_cell = 32        refinement ratio 4
#   is_periodic = "1 0 0" fine_lo = "0 0.25 0.25"   periodic, fine level on the periodic boundary
#   is_periodic = "1 1 1" eb_neumann = 1             singular (compared up to a constant)
composite_solve = 1
use_mlhypre = 1
mlhypre_max_fine_res = 1.e-7
linop_maxorder = 3
reltol = 1.e-11
prob_type = 1
max_level = 1
n_cell = 64
max_grid_size = 16
eb2.max_grid_size = 16
eb2.geom_type = sphere
eb2.sphere_center = 0.5 0.5 0.5
eb2.sphere_radius = 0.3
eb2.sphere_has_fluid_inside = 0
fine_lo = 0.25 0.25 0.25
fine_hi = 0.75 0.75 0.75
hypre_mlabeclap.hypre_solver = FlexGMRES
hypre_mlabeclap.hypre_preconditioner = BoomerAMG
verbose = 1
bottom_verbose = 0
