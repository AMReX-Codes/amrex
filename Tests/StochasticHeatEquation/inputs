amrex.throw_exception = 1  # throw C++ exceptions on AMReX errors
amrex.signal_handling = 0  # disable AMReX signal handlers

npts = 32            # number of cell centers in the 1D domain
max_grid_size = 16   # maximum number of cells per grid box
xlen = 32.e-9        # physical domain length

lambda = 70.e0       # thermal conductivity
rho = 7870.e0        # mass density
cv = 450.e0          # specific heat capacity
crossA = 4.e-18      # cross-sectional area for stochastic flux scaling
iopt = 2             # reservoir-face noise state: 1 boundary, 2 interior

dt = 1.e-12          # time step used when cfl <= 0
cfl = 0.1e0          # if positive, set dt from cfl*dx*dx/kappa
nstep = 20           # number of production steps after thermalization
ntherm = 5           # number of initial steps skipped by diagnostics
nout = 20            # diagnostic output interval after thermalization
nstat = 5            # statistics accumulation interval after thermalization
icor = 1             # 1-based reference cell index for correlations
ensout = 1           # output every ensout ensemble realizations

seed = 1022349098    # random-number seed

uinit = 300.         # initial state outside the middle region
jmidl = 26           # 1-based first cell in the middle region
jmidr = 75           # 1-based last cell in the middle region
midfact = 1.0e0      # multiplier applied to uinit in the middle region
is_hybrid = 0        # solver path selector; must be 0 for finite volume
iresr = 0            # right reservoir flag when non-periodic: 0 off, 1 on
iresl = 0            # left reservoir flag when non-periodic: 0 off, 1 on
iper = 1             # x-boundary periodicity flag: 1 periodic, 0 physical
uleft = 300.         # left reservoir state for non-periodic boundaries
uright = 300.        # right reservoir state for non-periodic boundaries
ensemble = 2         # number of ensemble realizations

ipdf = 0             # enable PDF histogram output when nonzero
write_ascii = 1      # write ASCII diagnostic data files when nonzero
plot_int = -1        # plotfile output interval; <= 0 disables plotfiles
