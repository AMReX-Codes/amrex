#!/usr/bin/env bash
# Single-source C++ compiler for AMReX_GPU_BACKEND=LOOM.
#
# Compile (-c): Loom's offload driver, loom-cxx, parses the source once with
# cxx and emits one object holding the host code (cxx's MLIR/LLVM back end),
# the device code of the launched kernels compiled for AMREX_LOOM_TARGET
# (registered at startup with amrex_loom_register_executable), and the kernel
# descriptors that the host code references through loom::kernel::kernel_ref.
# Kernels Loom cannot import or compile yet are dropped and reported; their
# descriptors stay unavailable, so launching one fails at run time.
# Link: clang++ with libc++, plus libhrx.
#
# Required environment (see Tools/Loom/single-source/env.sh):
#   AMREX_LOOM_CXX_DRIVER       loom-cxx
#   AMREX_LOOM_LOOMCXX_DIR      directory containing loomcxx/ headers
#   AMREX_LOOM_SYSTEM_INCLUDES  ':'-separated libc++/compiler/libc include dirs
#   AMREX_LOOM_LINK_CXX         clang++ used for linking
#   AMREX_LOOM_LIBCXX_ROOT      libc++ install with lib/
#   AMREX_LOOM_GCC_INSTALL_DIR  GCC's lib/gcc/<triple>/<version> (crt files)
#   AMREX_LOOM_HRX_LIB_DIR      directory containing libhrx.so
# Optional:
#   AMREX_LOOM_TARGET           device target (default gfx90a)
#   AMREX_LOOM_HOST_TRIPLE      host target triple (default x86_64-linux-gnu)
#   AMREX_LOOM_SYSROOT          sysroot holding glibc's libraries for linking
#   AMREX_LOOM_DEVICE_STRICT=1  fail the compile when the device pass fails,
#                               instead of keeping a host-only object
set -o pipefail
: "${AMREX_LOOM_CXX_DRIVER:?}" "${AMREX_LOOM_LOOMCXX_DIR:?}" "${AMREX_LOOM_LINK_CXX:?}"

compile=0
for a in "$@"; do [[ "$a" == "-c" ]] && compile=1; done

if [[ $compile == 0 ]]; then
  # Link. cxx emits non-PIC code, so executables link without PIE.
  : "${AMREX_LOOM_LIBCXX_ROOT:?}" "${AMREX_LOOM_GCC_INSTALL_DIR:?}"
  sysroot=() hrx=()
  [[ -n "${AMREX_LOOM_SYSROOT:-}" ]] && sysroot=(--sysroot="$AMREX_LOOM_SYSROOT")
  for a in "$@"; do
    if [[ "$a" == "-shared" || "$a" == *.o || "$a" == *.a ]]; then
      hrx=(-L"$AMREX_LOOM_HRX_LIB_DIR" -lhrx -Wl,-rpath,"$AMREX_LOOM_HRX_LIB_DIR")
      break
    fi
  done
  exec "$AMREX_LOOM_LINK_CXX" --gcc-install-dir="$AMREX_LOOM_GCC_INSTALL_DIR" "${sysroot[@]}" \
    -stdlib=libc++ -no-pie -L"$AMREX_LOOM_LIBCXX_ROOT/lib" -Wl,-rpath,"$AMREX_LOOM_LIBCXX_ROOT/lib" \
    "$@" "${hrx[@]}"
fi

# Compile. Include directories are explicit: loomcxx, then libc++, the
# compiler's headers and libc.
system=()
IFS=: read -r -a dirs <<< "${AMREX_LOOM_SYSTEM_INCLUDES:-}"
for d in "${dirs[@]}"; do [[ -n "$d" ]] && system+=(-isystem "$d"); done
on_failure=host-only
[[ "${AMREX_LOOM_DEVICE_STRICT:-0}" == 1 ]] && on_failure=error
exec "$AMREX_LOOM_CXX_DRIVER" --target="${AMREX_LOOM_HOST_TRIPLE:-x86_64-linux-gnu}" \
  --loom-target=amdgpu:"${AMREX_LOOM_TARGET:-gfx90a}" \
  --loom-register-function=amrex_loom_register_executable \
  --loom-drop-failed-kernels --loom-on-device-failure="$on_failure" \
  -I "$AMREX_LOOM_LOOMCXX_DIR" "${system[@]}" "$@"
