#!/usr/bin/env bash
# Host C++ compiler for single-source LOOM builds: cxx compiles, clang++ links.
#
# Used as AMREX_LOOM_HOST_CXX by amrex-loom-cxx. Both the host compile (here)
# and the Loom device pass read the same libc++ headers.
#
# Required environment:
#   AMREX_LOOM_CXX               cxx built with its MLIR back end
#   AMREX_LOOM_LIBCXX_ROOT       libc++ install: include/c++/v1 and lib/
#   AMREX_LOOM_GCC_INSTALL_DIR   GCC's lib/gcc/<triple>/<version> (compiler
#                                headers such as stddef.h; glibc crt files)
#   AMREX_LOOM_LINK_CXX          clang++ used for linking
# Optional:
#   AMREX_LOOM_SYSROOT           sysroot holding glibc's headers and libraries
#   AMREX_LOOM_HOST_CXX_LOG      file that records flags dropped for cxx
set -o pipefail
: "${AMREX_LOOM_CXX:?}" "${AMREX_LOOM_LIBCXX_ROOT:?}" "${AMREX_LOOM_GCC_INSTALL_DIR:?}" "${AMREX_LOOM_LINK_CXX:?}"
C=$AMREX_LOOM_LIBCXX_ROOT
sysroot=()
[[ -n "${AMREX_LOOM_SYSROOT:-}" ]] && sysroot=(--sysroot="$AMREX_LOOM_SYSROOT")

compile=0
for a in "$@"; do [[ "$a" == "-c" ]] && compile=1; done

if [[ $compile == 0 ]]; then
  # cxx emits non-PIC code, so executables link without PIE.
  exec "$AMREX_LOOM_LINK_CXX" --gcc-install-dir="$AMREX_LOOM_GCC_INSTALL_DIR" "${sysroot[@]}" \
    -stdlib=libc++ -no-pie -L"$C/lib" -Wl,-rpath,"$C/lib" "$@"
fi

# Keep the flags cxx understands; record the rest (warnings, -fPIC, -Xclang ...).
args=() dropped=()
while [[ $# -gt 0 ]]; do
  a=$1; shift
  case "$a" in
    -c|-E|-O*|-D*|-U*|-I*|-MD|-MMD|-MP) args+=("$a") ;;
    -o|-MT|-MF|-MQ|-isystem|-include|-x) args+=("$a" "$1"); shift ;;
    -std=gnu++*) args+=("-std=c++${a#-std=gnu++}") ;;
    -std=*) args+=("$a") ;;
    -Xclang) dropped+=("$a" "$1"); shift ;;
    -*) dropped+=("$a") ;;
    *) args+=("$a") ;;
  esac
done
if [[ -n "${AMREX_LOOM_HOST_CXX_LOG:-}" && ${#dropped[@]} -gt 0 ]]; then
  echo "dropped: ${dropped[*]}" >> "$AMREX_LOOM_HOST_CXX_LOG"
fi
exec "$AMREX_LOOM_CXX" --target=x86_64-linux-gnu "${sysroot[@]}" \
  -nostdinc++ -isystem "$C/include/c++/v1" -isystem "$AMREX_LOOM_GCC_INSTALL_DIR/include" \
  -fno-exceptions "${args[@]}"
